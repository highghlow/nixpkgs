diff --git a/util-linux/hwclock.c b/util-linux/hwclock.c
index c3fd0eb57..a98bdbbac 100644
--- a/util-linux/hwclock.c
+++ b/util-linux/hwclock.c
@@ -140,7 +140,17 @@ static void set_kernel_tz(const struct timezone *tz)
 #if !defined(SYS_settimeofday) && defined(SYS_settimeofday_time32)
 # define SYS_settimeofday SYS_settimeofday_time32
 #endif
+
+#if defined(SYS_settimeofday)
 	int ret = syscall(SYS_settimeofday, NULL, tz);
+#else
+    /* some architectures do not have this syscall.
+     * in that case we can't do anything
+     * */
+    bb_simple_error_msg_and_die("setting kernel timezone is not supported");
+    int ret = 1;
+#endif
+
 #else
 	int ret = settimeofday(NULL, tz);
 #endif
